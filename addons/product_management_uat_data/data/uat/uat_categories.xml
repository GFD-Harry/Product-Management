<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="uat_category_electronics" model="product.management.category">
            <field name="name">Electronics</field>
            <field name="description">Electronic products used for customer consultation.</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
        </record>

        <record id="uat_category_laptop" model="product.management.category">
            <field name="name">Laptop</field>
            <field name="description">Portable computers for office, study, and business use.</field>
            <field name="parent_id" ref="uat_category_electronics"/>
            <field name="active">True</field>
            <field name="sequence">20</field>
        </record>

        <record id="uat_category_smartphone" model="product.management.category">
            <field name="name">Smartphone</field>
            <field name="description">Mobile phones for communication, photography, and daily productivity.</field>
            <field name="parent_id" ref="uat_category_electronics"/>
            <field name="active">True</field>
            <field name="sequence">30</field>
        </record>

        <record id="uat_category_accessory" model="product.management.category">
            <field name="name">Accessory</field>
            <field name="description">Accessories that support laptops, smartphones, and office work.</field>
            <field name="parent_id" ref="uat_category_electronics"/>
            <field name="active">True</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
