<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_management_product_list" model="ir.ui.view">
        <field name="name">product.management.product.list</field>
        <field name="model">product.management.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <header>
                    <button
                        name="action_open_compare_wizard"
                        type="object"
                        string="Compare Products"
                        class="btn-primary" 
                    />
                </header>
                
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [50, 50]}"/>
                <field name="default_code" placeholder="Category-Brand-Product"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand_id" placeholder="Select or create a brand"/>
                <field name="list_price"/>
                <field name="qty_available"/>
                <field name="stock_status"/>
                <field name="product_status"/>
            </list>
        </field> 
    </record>

    <record id="view_product_management_product_field_value_form" model="ir.ui.view">
        <field name="name">product.management.product.field.value.form</field>
        <field name="model">product.management.product.field.value</field>
        <field name="arch" type="xml">
            <form string="Specification Value">
                <sheet>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="field_id" readonly="1" force_save="1"/>
                        <field name="field_type" readonly="1"/>
                        <field name="required" readonly="1"/>
                        <field name="help" readonly="1"/>
                    </group>

                    <group string="Value">
                        <field name="value_char" invisible="field_type != 'char'"/>
                        <field name="value_text" invisible="field_type != 'text'"/>
                        <field name="value_integer" invisible="field_type != 'integer'"/>
                        <field name="value_float" invisible="field_type != 'float'"/>
                        <field name="value_boolean" invisible="field_type != 'boolean'"/>
                        <field name="value_date" invisible="field_type != 'date'"/>
                        <field name="value_datetime" invisible="field_type != 'datetime'"/>
                        <field
                            name="option_id"
                            invisible="field_type != 'selection'"
                            domain="[('field_id', '=', field_id)]"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_management_product_form" model="ir.ui.view">
        <field name="name">product.management.product.form</field>
        <field name="model">product.management.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>

                    <group>
                        <group>
                            <field name="default_code" placeholder="Example: LAP-DELL-XPS13"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="brand_id" placeholder="Select or create a brand"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="qty_available"/>
                            <field name="stock_status"/>
                            <field name="product_status"/>
                            <field name="sequence"/>
                        </group>
                    </group>

                    <group string="Consultation">
                        <field name="purpose" placeholder="Describe what this product is used for or which customer need it fits."/>
                    </group>

                    <notebook>
                        <page string="Specification">
                            <field name="field_value_ids" mode="list,form">
                                <list create="0" delete="0" open_form_view="1">
                                    <field name="field_id" readonly="1" force_save="1"/>
                                    <field name="required" readonly="1"/>
                                    <field name="display_value" readonly="1"/>
                                </list>

                                <form string="Specification Value">
                                    <sheet>
                                        <group>
                                            <field name="product_id" readonly="1" invisible="not product_id"/>
                                            <field name="field_id" readonly="1" force_save="1"/>
                                            <field name="field_type" readonly="1"/>
                                            <field name="required" readonly="1"/>
                                            <field name="help" readonly="1"/>
                                        </group>

                                        <group string="Value">
                                            <field name="value_char" invisible="field_type != 'char'"/>
                                            <field name="value_text" invisible="field_type != 'text'"/>
                                            <field name="value_integer" invisible="field_type != 'integer'"/>
                                            <field name="value_float" invisible="field_type != 'float'"/>
                                            <field name="value_boolean" invisible="field_type != 'boolean'"/>
                                            <field name="value_date" invisible="field_type != 'date'"/>
                                            <field name="value_datetime" invisible="field_type != 'datetime'"/>
                                            <field name="option_id"
                                                invisible="field_type != 'selection'"
                                                domain="[('field_id', '=', field_id)]"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <!--
                            <field
                                name="field_value_ids"
                                mode="list,form"
                                context="{'form_view_ref': 'product_management.view_product_management_product_field_value_form'}"
                            >
                                <list create="0" delete="0" open_form_view="1">
                                    <field name="field_id" readonly="1" force_save="1"/>
                                    <field name="required" readonly="1"/>
                                    <field name="display_value" readonly="1"/>
                                </list>
                            </field>
                            -->
                        </page>
                    </notebook>
                </sheet>
            </form>


        </field>
    </record>
    
    <record id="view_product_management_product_search" model="ir.ui.view">
        <field name="name">product.management.product.search</field>
        <field name="model">product.management.product</field>
        <field name="arch" type="xml">
            <search string="Products">
                <field name="name"/>
                <field name="default_code"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <field name="purpose"/>

                <filter name="in_stock" string="Stock: In Stock" domain="[('stock_status', '=', 'in_stock')]"/>
                <filter name="low_stock" string="Stock: Low Stock" domain="[('stock_status', '=', 'low_stock')]"/>
                <filter name="out_of_stock" string="Stock: Out of Stock" domain="[('stock_status', '=', 'out_of_stock')]"/>

                <separator/>

                <filter name="available" string="Product: Available" domain="[('product_status', '=', 'available')]"/>
                <filter name="discontinued" string="Product: Discontinued" domain="[('product_status', '=', 'discontinued')]"/>

                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_by_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                <filter name="group_by_stock_status" string="Stock Status" context="{'group_by': 'stock_status'}"/>
                <filter name="group_by_product_status" string="Product Status" context="{'group_by': 'product_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_product_management_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.management.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_management_product_search"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{"search_default_available": 1}</field>
    </record>


</odoo>
